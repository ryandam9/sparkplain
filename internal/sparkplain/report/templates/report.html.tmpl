{{- $r := .R -}}{{- $a := $r.Application -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{$r.Tool}}">
<title>{{if $a.Name}}{{$a.Name}}{{else}}{{$a.ID}}{{end}} · sparkplain</title>
<style>{{.CSS}}</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand"><b>sparkplain</b> report · {{$r.Tool}} · generated {{time $r.GeneratedAt "dt"}}</div>
    <div class="topr">{{if .Explorer}}<a class="themebtn" href="{{.Explorer}}">Open the explorer</a>{{end}}<button type="button" class="themebtn" id="themebtn" hidden>Light / dark</button></div>
  </div>

  <header class="head">
    <h1>{{if $a.Name}}{{$a.Name}}{{else}}Spark application{{end}} <span class="status {{statusClass $a.Status}}">{{statusLabel $a.Status}}</span></h1>
    <div class="idline">
      <span>App <b class="mono">{{if $a.ID}}{{$a.ID}}{{else}}unknown{{end}}</b>{{if $a.AttemptID}} · attempt {{$a.AttemptID}}{{end}}</span>
      {{if $a.SparkVersion}}<span><b>Spark {{$a.SparkVersion}}</b>{{with rt $r "Java"}} · Java {{.}}{{end}}{{with rt $r "Hadoop"}} · Hadoop {{.}}{{end}}{{if $a.Master}} · {{$a.Master}}{{end}}{{if $a.DeployMode}} · {{$a.DeployMode}} mode{{end}}</span>{{end}}
      {{if $a.User}}<span>User <b>{{$a.User}}</b></span>{{end}}
      {{with $r.Cluster}}<span>Cluster <b class="mono">{{.ID}}</b>{{if .Name}} ({{.Name}}){{end}}{{if .Release}} · {{.Release}}{{end}}</span>{{end}}
      {{if not $a.Start.IsZero}}<span><b class="num">{{time $a.Start "dt"}} → {{if $a.End.IsZero}}still running{{else}}{{time $a.End "hms"}}{{end}}</b> <span class="tzlabel">{{.Zone}}</span></span>{{end}}
    </div>
    <div class="mode">
      {{if and $r.EventLog (eq $r.EventLog.Layout "container-logs")}}{{with $r.EventLog}}<strong>Event log: not supplied. sparkplain made the run again from the driver log.</strong>
      <span>The jobs, stages, tasks and executors come from {{num .Events}} events that sparkplain made from the lines of the driver log ({{.Input}}). Task metrics (rows, bytes, CPU and GC time, spill, memory), SQL plans and the Spark configuration are only in the event log. The sections that use them tell you this. {{if $r.Logs}}Container, step and node logs: {{len $r.Logs.Files}} file{{if ne (len $r.Logs.Files) 1}}s{{end}} read.{{end}} {{$.Complete}} sections are complete, {{$.Partial}} are partial, and {{$.Needs}} have no data from this run. Exit code {{$r.ExitCode}}{{if eq $r.ExitCode 3}} (partial){{end}}.</span>{{end}}
      {{else if $r.EventLog}}{{with $r.EventLog}}<strong>Event log: {{if $r.EventLog.Truncated}}partly read{{else}}read{{end}}.</strong>
      <span>Layout: {{.Layout}}, codec {{.Codec}}, {{len .Files}} file{{if ne (len .Files) 1}}s{{end}}, {{num .Events}} events. {{if $r.Logs}}Container, step and node logs: {{len $r.Logs.Files}} file{{if ne (len $r.Logs.Files) 1}}s{{end}} read.{{else}}sparkplain did not read the container, step and node logs. To read them, use -cluster-id, or -from with a copy of them.{{end}} {{$.Complete}} sections are complete, {{$.Partial}} are partial, and {{$.Needs}} have no data from this run. Exit code {{$r.ExitCode}}{{if eq $r.ExitCode 3}} (partial){{end}}.</span>{{end}}
      {{else if $r.Logs}}<strong>Event log: not read.</strong> <span>The summary, findings, identity and sources come from the YARN records and {{len $r.Logs.Files}} container, step and node log{{if ne (len $r.Logs.Files) 1}}s{{end}}. The sections that use the event log are empty. The Sources panel shows why the event log is missing. Exit code {{$r.ExitCode}}.</span>
      {{else}}<strong>Event log: not read.</strong> <span>All sections below use it. The Sources panel shows the problem. Exit code {{$r.ExitCode}}.</span>{{end}}
    </div>
    {{if $r.AccessGaps}}<div class="missing access">
      <h3>No access to {{len $r.AccessGaps}} source{{if ne (len $r.AccessGaps) 1}}s{{end}}, so parts of this report are missing</h3>
      <ul>{{range $r.AccessGaps}}<li><b>{{.Source}}</b>: without it, the report cannot show {{.Missing}}. The necessary access is {{.Needs}}.</li>{{end}}</ul>
      <p>sparkplain continued with all the other sources. The Sources panel shows each error.</p>
    </div>{{end}}
  </header>

  <div class="layout">
    <nav class="toc" aria-label="Sections">
      <a href="#summary">What happened <span class="dot full"></span></a>
      <a href="#anatomy">The run at a glance <span class="dot full"></span></a>
      <a href="#findings">Findings <span class="dot full"></span></a>
      <a href="#coverage">What this report covers <span class="dot full"></span></a>
      <a href="#sources">Sources <span class="dot full"></span></a>
      {{if .Explorer}}<div class="tocx">
        <span class="tocxh">More in the explorer</span>
        <a href="{{xTab .Explorer "timeline"}}">Timeline →</a>
        <a href="{{xTab .Explorer "stages"}}">Jobs and stages →</a>
        <a href="{{xTab .Explorer "executors"}}">Executors, memory and CPU →</a>
        <a href="{{xTab .Explorer "sql"}}">SQL queries →</a>
        {{if $r.TaskStories}}<a href="{{xTab .Explorer "tasklogs"}}">What each task did →</a>{{end}}
        <a href="{{xTab .Explorer "config"}}">Configuration, identity and access →</a>
      </div>{{end}}
    </nav>

    <main>
      <section id="summary">
        <div class="story">
          <div class="sechead"><h2>What happened</h2>{{if .Explorer}}<a class="xlink" href="{{xTab .Explorer "summary"}}">Open in the explorer →</a>{{end}}</div>
          <ul>{{range $r.Summary.Sentences}}<li>{{prose . "s"}}</li>{{end}}</ul>
        </div>
        {{if $r.Summary.KPIs}}<div class="kpis">
          {{range $r.Summary.KPIs}}<div class="kpi"><span class="l">{{.Label}}</span><span class="v{{if .Tone}} {{.Tone}}{{end}}">{{.Value}}{{if .Unit}} <small>{{.Unit}}</small>{{end}}</span><span class="x">{{.Explain}}</span></div>
          {{end}}
        </div>{{end}}
      </section>

      {{with anatomy $r}}<section id="anatomy">
        <div class="sechead"><h2>The run at a glance</h2><span class="note">All of the run in one picture: where it ran, what it got and what it used.</span>{{if $.Explorer}}<a class="xlink" href="{{xTab $.Explorer "anatomy"}}">Open in the explorer →</a>{{end}}</div>
        {{.}}
      </section>{{end}}

      <section id="coverage">
        <div class="sechead"><h2>What this report covers</h2></div>
        <p class="lede">This table shows what each part of the analysis can show for this run, the source of its data, and what it cannot show yet. This page is the summary. {{if .Explorer}}Each part opens in the explorer, which has the details.{{else}}The explorer (sparkplain -format explorer) has the details.{{end}}</p>
        <div class="tbl"><table>
          <thead><tr><th>Section</th><th>Status</th><th>Shown</th><th>Not shown yet</th></tr></thead>
          <tbody>{{range $r.Coverage}}<tr><td>{{$t := .Title}}{{with xTab $.Explorer .ID}}<a href="{{.}}">{{$t}} →</a>{{else}}{{$t}}{{end}}</td><td><span class="pill {{cov .Coverage}}">{{covLabel .Coverage}}</span></td><td>{{.Shown}}</td><td>{{if .Missing}}{{join .Missing "; "}}{{else}}—{{end}}</td></tr>
          {{end}}</tbody>
        </table></div>
      </section>

      <section id="findings">
        <div class="sechead"><h2>Findings</h2><span class="note">{{.Crit}} critical · {{.Warn}} warning · {{.Info}} info. The most severe come first. Each finding links to its log line.</span>{{if .Explorer}}<a class="xlink" href="{{xTab .Explorer "findings"}}">Open in the explorer →</a>{{end}}</div>
        {{if $r.Findings}}<div class="findings">
          {{range $i, $f := $r.Findings}}<article class="finding {{sev .Severity}}" id="finding-{{add $i 1}}"><div class="stripe"></div><div class="body">
            <div class="t"><span class="fnum {{sev .Severity}}">{{add $i 1}}</span><span class="pill {{sevPill .Severity}}">{{sevLabel .Severity}}</span><h3>{{.Title}}</h3></div>
            <div class="fpart what"><span class="k">{{if eq (sev .Severity) "crit"}}Error{{else if eq (sev .Severity) "warn"}}Problem{{else}}Note{{end}}</span><div>{{prose .Explanation "expl"}}</div></div>
            {{if .Evidence}}<div class="fpart evid"><span class="k">Evidence</span><div>{{range .Evidence}}<p class="ev">{{if .Source.File}}{{src .Source}} {{end}}{{if and $.Explorer .Ref}}<a href="{{explorerURL $.Explorer .Ref}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}</p>{{end}}</div></div>{{end}}
            {{if .Fix}}<div class="fpart try"><span class="k">Try</span><div>{{prose .Fix "fix"}}</div></div>{{end}}
          </div></article>
          {{end}}
        </div>{{else}}<p class="note">The rules found no problems.</p>{{end}}
      </section>

      <section id="sources">
        <div class="sechead"><h2>Sources</h2>{{if .Explorer}}<a class="xlink" href="{{xTab .Explorer "sources"}}">Open in the explorer →</a>{{end}}</div>
        <div class="tbl"><table>
          <thead><tr><th>Source</th><th>Status</th><th>What was read</th></tr></thead>
          <tbody>{{range $r.Sources}}<tr><td>{{.Name}}{{if .Location}}<span class="sub mono">{{.Location}}</span>{{end}}</td><td><span class="pill {{srcPill .Status}}">{{srcLabel .Status}}</span>{{if .Class}}<span class="sub">{{.Class}}</span>{{end}}</td><td>{{.Detail}}</td></tr>
          {{end}}</tbody>
        </table></div>
        {{range $r.Sources}}{{if .Files}}{{$c := fileCounts .Files}}<details><summary>{{.Name}}: {{len .Files}} object{{if ne (len .Files) 1}}s{{end}} ({{index $c "read"}} read, {{index $c "skipped"}} skipped, {{index $c "error"}} failed)</summary><div class="inner">
          <div class="tbl"><table><thead><tr><th>Object</th><th class="num">Size</th><th>Status</th><th>Why</th></tr></thead>
          <tbody>{{range headFiles .Files 500}}<tr><td class="mono">{{.Location}}</td><td class="num">{{bytes .Bytes}}</td><td>{{.Status}}{{if .Class}} <span class="sub">{{.Class}}</span>{{end}}</td><td>{{if eq .Status "error"}}<span class="bad">{{.Detail}}</span>{{else if .Detail}}{{.Detail}}{{else}}—{{end}}</td></tr>{{end}}</tbody></table></div>
          {{if gt (len .Files) 500}}<p class="sub">This list shows the first 500. report.json lists all {{len .Files}}.</p>{{end}}
        </div></details>{{end}}{{end}}
        {{with $r.EventLog}}<details><summary>Event log details: {{len .Files}} file{{if ne (len .Files) 1}}s{{end}}, {{num .Lines}} lines</summary><div class="inner">
          <div class="tbl"><table><thead><tr><th>File</th><th>Codec</th><th class="num">Size</th><th class="num">Unpacked</th><th class="num">Lines</th><th>Problem</th></tr></thead>
          <tbody>{{range .Files}}<tr><td class="mono">{{.Name}}</td><td>{{.Codec}}</td><td class="num">{{bytes .Bytes}}</td><td class="num">{{bytes .Decompressed}}</td><td class="num">{{num .Lines}}</td><td>{{if .Error}}<span class="bad">{{.Error}}</span>{{else}}—{{end}}</td></tr>{{end}}</tbody></table></div>
          <dl class="kv">
            <dt>Events</dt><dd>{{num .Events}}</dd>
            <dt>Malformed lines</dt><dd>{{num .Malformed}}{{if .Malformed}}, first at <span class="srcref">{{src .FirstMalformed}}</span>{{end}}</dd>
            <dt>Unknown events</dt><dd>{{if .UnknownEvents}}{{range $k, $v := .UnknownEvents}}{{$k}} ({{num $v}}) {{end}}{{else}}none{{end}}</dd>
            <dt>Unknown fields</dt><dd>{{if .UnknownFields}}{{range $k, $v := .UnknownFields}}{{$k}} ({{num $v}}) {{end}}{{else}}none{{end}}</dd>
            <dt>Values hidden</dt><dd>{{num .Redacted}} settings with names that look like secrets</dd>
          </dl>
          {{if .Notes}}<ul class="note">{{range .Notes}}<li>{{.}}</li>{{end}}</ul>{{end}}
        </div></details>{{end}}
      </section>
    </main>
  </div>

  <footer>
    <span>{{$r.Tool}} · report schema {{$r.SchemaVersion}} · each value links to its log line</span>
    <span>Times in <span class="tzlabel">{{.Zone}}</span></span>
  </footer>
</div>
<script>{{.JS}}</script>
</body>
</html>
